<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:orientation="vertical" android:padding="20dp" android:background="#050B16" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:id="@+id/logo" android:text="GCA FORCE-IPTV PRO" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Connexion..." android:textColor="#8DA5BF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingBottom="14dp"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/homeBtn" android:text="ACCUEIL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/liveBtn" android:text="LIVE TV" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/activateBtn" android:text="ACTIVATION" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Button android:id="@+id/devicesBtn" android:text="APPAREILS" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
<FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="18dp"/>
</LinearLayout>